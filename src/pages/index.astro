---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${b}/${p.replace(/^\//, '')}`;

const lekcje = (await getCollection('lekcje')).sort((a, c) => a.data.numer - c.data.numer);
const reguly = await getCollection('reguly');
const quizy = lekcje.filter((l) => l.data.quiz);
const quizyDash = [
  ...quizy.map((l) => ({ id: l.data.quiz!, tytul: `${l.data.emoji} ${String(l.data.numer).padStart(2, '0')}` })),
  { id: 'mix', tytul: '⚡ Mix' },
];

// Słówka: sumujemy wszystkie talie, żeby na kafelku pokazać realną liczbę.
const talieSlowek = import.meta.glob<{ slowa: unknown[] }>('../data/slowka/*.json', { eager: true });
const slowekRazem = Object.values(talieSlowek).reduce((s, t) => s + t.slowa.length, 0);
// Cały kurs do egzaminu B1 = 17 lekcji (plan w 00-Plan-kursu).
// Math.max pilnuje, żeby pasek nigdy nie przekroczył 100%, gdyby lekcji
// przybyło szybciej niż ktoś zaktualizuje tę liczbę.
const KURS_TOTAL = Math.max(17, lekcje.length);
const pct = Math.round((lekcje.length / KURS_TOTAL) * 100);
const slowa = ['cześć', 'dziękuję', 'góra', 'jezioro', 'zmęczenie', 'władza', 'kompromis', 'przyroda', 'najlepszy', 'więcej', 'szczyt', 'wolność'];
---
<Base title="Polski Klub — Oleg, Lena i Żenia" active="">
  <section class="hero">
    <p class="kicker" style="color: var(--mak)">kurs polskiego · A2 → B1</p>
    <h1 class="hero-title">
      <span class="line-1">UCZYMY SIĘ</span>
      <span class="line-2">PO POLSKU<span class="dot">.</span></span>
    </h1>
    <p class="hero-sub">
      Co tydzień spotkanie: <strong>tekst</strong> → <strong>reguła</strong> → <strong>słowa</strong> → <strong>quiz</strong>.
      Trzy osoby, jeden cel — certyfikat B1 w listopadzie.
    </p>
    <div class="kurs-progress" title={`${lekcje.length} z ${KURS_TOTAL} lekcji na stronie`}>
      <span class="kp-label">postęp kursu</span>
      <span class="kp-bar"><span class="kp-fill" style={`width:${pct}%`}></span></span>
      <span class="kp-num">{lekcje.length}/{KURS_TOTAL}</span>
    </div>
    <svg class="hero-mountains" viewBox="0 0 880 120" preserveAspectRatio="none" aria-hidden="true">
      <polygon points="0,120 140,34 260,120" fill="var(--panel-2)" />
      <polygon points="180,120 350,10 520,120" fill="var(--mak)" opacity="0.85" />
      <polygon points="430,120 600,42 760,120" fill="var(--amber)" opacity="0.9" />
      <polygon points="640,120 800,58 880,120" fill="var(--panel-2)" />
    </svg>
  </section>

  <div class="word-strip" aria-hidden="true">
    <div class="word-track">
      {[...slowa, ...slowa].map((w) => <span class="word">{w}</span>)}
    </div>
  </div>

  <section class="portals">
    <a class="portal p-lekcje" href={href('lekcje/')}>
      <span class="portal-num">01</span>
      <span class="portal-name">Lekcje</span>
      <span class="portal-desc">teksty, słowa i ćwiczenia — {lekcje.length} na stronie</span>
      <span class="portal-go">wchodzę →</span>
    </a>
    <a class="portal p-reguly" href={href('reguly/')}>
      <span class="portal-num">02</span>
      <span class="portal-name">Reguły</span>
      <span class="portal-desc">gramatyka w pigułce — {reguly.length} ściąg</span>
      <span class="portal-go">wchodzę →</span>
    </a>
    <a class="portal p-slowka" href={href('slowka/')}>
      <span class="portal-num">03</span>
      <span class="portal-name">Słówka</span>
      <span class="portal-desc">fiszki z powtórkami — {slowekRazem} słów z lekcji</span>
      <span class="portal-go">powtarzam →</span>
    </a>
    <a class="portal p-quizy" href={href('quizy/')}>
      <span class="portal-num">04</span>
      <span class="portal-name">Quizy</span>
      <span class="portal-desc">sprawdź się — {quizy.length} quizów z konfetti</span>
      <span class="portal-go">gram! →</span>
    </a>
  </section>

  <section class="latest">
    <h2 class="section-title">Ostatnie lekcje</h2>
    <ol class="lesson-list">
      {lekcje.slice(-3).reverse().map((l) => (
        <li class="lesson-card">
          <a href={href(`lekcje/${l.id}/`)}>
            <span class="lesson-num">{String(l.data.numer).padStart(2, '0')}</span>
            <span class="lesson-body">
              <span class="lesson-title">{l.data.emoji} {l.data.tytul}</span>
              <span class="lesson-meta">{l.data.gramatyka}</span>
            </span>
            <span class="lesson-go" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="latest-all"><a href={href('lekcje/')}>wszystkie lekcje →</a></p>
  </section>

  <section class="klub" id="klub">
    <h2 class="section-title">Klub — kto co przeszedł</h2>
    <p class="klub-zacheta" id="klub-zacheta">
      <a href={href('profil/')}>Zaloguj się</a>, żeby zbierać wyniki i widzieć postęp całej trójki.
    </p>
    <div class="klub-tabela-wrap" id="klub-wrap" hidden>
      <table class="klub-tabela"><thead id="klub-head"></thead><tbody id="klub-body"></tbody></table>
    </div>
    <script type="application/json" id="klub-quizy" set:html={JSON.stringify(quizyDash).replace(/</g, '\\u003c')} />
  </section>

  <a class="mix-card" href={href('mix/')}>
    <span class="mix-bolt" aria-hidden="true">⚡</span>
    <span class="mix-body">
      <span class="mix-kicker">quiz specjalny</span>
      <span class="mix-title">Wielki Mix — wszystko naraz</span>
      <span class="mix-desc">
        Sześć tematów z całego kursu, wymieszanych bez podziału na bloki: stopniowanie, biernik,
        narzędnik, celownik, modalne i dopełniacz. Najpierw rozpoznaj przypadek — potem odpowiedz.
      </span>
    </span>
    <span class="mix-go" aria-hidden="true">→</span>
  </a>

  <script>
    // Firebase ladujemy tylko gdy ktos prawdopodobnie ma sesje —
    // chip-cache pk_kto_v1 to tani sygnal bez SDK (uwaga z final review)
    const quizy: { id: string; tytul: string }[] = JSON.parse(document.getElementById('klub-quizy')!.textContent!);

    let maSesje = false;
    try { maSesje = !!localStorage.getItem('pk_kto_v1'); } catch {}

    if (maSesje) import('../scripts/chmura.js').then(async ({ gotowyUzytkownik, pobierzProfile }) => {
      const user = await gotowyUzytkownik();
      if (!user) return; // zostaje zacheta do logowania
      let profile;
      try {
        profile = await pobierzProfile();
      } catch {
        return; // brak sieci / reguly — zostaje zacheta, bez pustej tabeli
      }
      profile.sort((a, b) => String(a.name ?? '').localeCompare(String(b.name ?? '')));
      document.getElementById('klub-zacheta')!.hidden = true;
      document.getElementById('klub-wrap')!.hidden = false;
      const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
      document.getElementById('klub-head')!.innerHTML =
        `<tr><th>Quiz</th>${profile.map((p) => `<th>${esc(p.emoji)} ${esc(p.name)}</th>`).join('')}</tr>`;
      document.getElementById('klub-body')!.innerHTML = quizy.map((q) =>
        `<tr><td>${esc(q.tytul)}</td>${profile.map((p) => {
          const w = p.best?.[q.id];
          return `<td>${w ? `<strong>${Number(w.pct)}%</strong>` : '—'}</td>`;
        }).join('')}</tr>`
      ).join('');
    });
  </script>
</Base>

<style>
  .hero { position: relative; padding: 42px 0 0; overflow: hidden; }
  .hero-title {
    font-size: clamp(2.6rem, 9vw, 5rem);
    font-weight: 800;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .hero-title span { display: block; }
  .line-1 { color: var(--text); animation: rise 0.6s 0.05s both; }
  .line-2 { color: var(--amber); animation: rise 0.6s 0.15s both; }
  .dot { display: inline !important; color: var(--mak); }
  .hero-sub {
    max-width: 48ch;
    color: var(--text-dim);
    margin: 16px 0 0;
    animation: rise 0.6s 0.28s both;
  }
  .hero-sub strong { color: var(--text); }
  .hero-mountains { display: block; width: 100%; height: 84px; margin-top: 18px; animation: rise 0.7s 0.38s both; }

  .kurs-progress {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 22px;
    max-width: 420px;
    animation: rise 0.6s 0.34s both;
  }
  .kp-label {
    font-family: var(--font-display);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .kp-bar {
    flex: 1;
    height: 8px;
    background: var(--panel-2);
    border-radius: 99px;
    overflow: hidden;
  }
  .kp-fill {
    display: block;
    height: 100%;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--mak), var(--amber));
  }
  .kp-num { font-family: var(--font-display); font-weight: 800; color: var(--amber); font-size: 0.9rem; }

  /* przewijająca się taśma słów — plakat żyje */
  .word-strip {
    overflow: hidden;
    margin: 26px -18px 0;
    padding: 10px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .word-track {
    display: flex;
    gap: 34px;
    width: max-content;
    animation: slide 36s linear infinite;
  }
  .word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .word:nth-child(3n) { color: var(--amber); opacity: 0.85; }
  .word:nth-child(5n) { color: var(--mak); opacity: 0.85; }
  @keyframes slide {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* trzy portale */
  .portals {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 34px;
  }
  .portal {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px 18px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 4px);
    text-decoration: none;
    color: var(--text);
    position: relative;
    overflow: hidden;
    transition: transform 0.18s ease, border-color 0.18s ease;
    animation: rise 0.5s 0.45s both;
  }
  .portal::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: var(--pc);
  }
  .p-lekcje { --pc: var(--amber); }
  .p-reguly { --pc: var(--mak); }
  .p-slowka { --pc: var(--blekit); }
  .p-quizy { --pc: var(--zielony); }
  .portal:hover { transform: translateY(-4px); border-color: var(--pc); }
  .portal-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.2rem;
    color: var(--pc);
    line-height: 1;
    opacity: 0.9;
  }
  .portal-name { font-family: var(--font-display); font-weight: 800; font-size: 1.35rem; }
  .portal-desc { color: var(--text-dim); font-size: 0.85rem; min-height: 2.4em; }
  .portal-go {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--pc);
    margin-top: 6px;
  }

  .section-title {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--amber);
    margin: 44px 0 16px;
  }
  .lesson-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .lesson-card a {
    display: flex;
    align-items: center;
    gap: 16px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 15px 18px;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }
  .lesson-card a:hover { transform: translateX(6px); border-color: var(--amber); background: var(--panel-2); }
  .lesson-card a:hover .lesson-go { transform: translateX(4px); color: var(--amber); }
  .lesson-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.8rem;
    color: var(--mak);
    min-width: 50px;
    line-height: 1;
  }
  .lesson-body { flex: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .lesson-title { font-family: var(--font-display); font-weight: 700; font-size: 1.02rem; }
  .lesson-meta { color: var(--text-dim); font-size: 0.85rem; }
  .lesson-go { font-size: 1.3rem; color: var(--text-dim); transition: transform 0.18s ease, color 0.18s ease; }
  .latest-all { margin: 14px 2px 0; }
  .latest-all a { font-family: var(--font-display); font-weight: 700; text-decoration: none; }

  /* karta-skrót do quizu-skrzyżowania */
  .mix-card {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 40px;
    padding: 22px 22px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 4px);
    text-decoration: none;
    color: var(--text);
    position: relative;
    overflow: hidden;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }
  .mix-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 5px;
    background: linear-gradient(90deg, var(--mak), var(--amber), var(--zielony));
  }
  .mix-card:hover { transform: translateY(-4px); border-color: var(--zielony); background: var(--panel-2); }
  .mix-card:hover .mix-go { transform: translateX(4px); color: var(--zielony); }
  .mix-bolt { font-size: 2.4rem; line-height: 1; }
  .mix-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .mix-kicker {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--zielony);
  }
  .mix-title { font-family: var(--font-display); font-weight: 800; font-size: 1.25rem; }
  .mix-desc { color: var(--text-dim); font-size: 0.88rem; }
  .mix-go { font-size: 1.4rem; color: var(--text-dim); transition: transform 0.18s ease, color 0.18s ease; }

  @media (max-width: 640px) {
    .portals { grid-template-columns: 1fr; }
    .portal-desc { min-height: 0; }
    .mix-card { gap: 14px; padding: 20px 18px; }
    .mix-bolt { font-size: 1.9rem; align-self: flex-start; }
    .mix-go { display: none; }
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .klub-zacheta { color: var(--text-dim); }
  .klub-tabela-wrap { overflow-x: auto; }
  .klub-tabela { border-collapse: collapse; width: 100%; }
  .klub-tabela th, .klub-tabela td { border: 1px solid var(--line); padding: 7px 12px; text-align: left; font-size: 0.92rem; }
  .klub-tabela th { background: var(--panel-2); font-family: var(--font-display); }
  .klub-tabela td strong { color: var(--zielony); }
</style>
