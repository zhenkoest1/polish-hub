---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${b}/${p.replace(/^\//, '')}`;

const lekcje = (await getCollection('lekcje')).sort((a, c) => a.data.numer - c.data.numer);
const quizy = lekcje.filter((l) => l.data.quiz);
---
<Base title="Quizy — Polski Klub" active="quizy">
  <header class="page-head">
    <p class="kicker" style="color: var(--zielony)">sprawdź się — wynik ≥ 90% = konfetti 🎉</p>
    <h1 class="page-h1">Quizy</h1>
  </header>

  <div class="quiz-grid">
    {quizy.map((l, i) => (
      <a class="quiz-card" href={href(`quizy/${l.data.quiz}/`)} style={`animation-delay: ${i * 70}ms`}>
        <span class="quiz-emoji">{l.data.emoji}</span>
        <span class="quiz-title">Quiz {String(l.data.numer).padStart(2, '0')} — {l.data.tytul}</span>
        <span class="quiz-meta">{l.data.gramatyka}</span>
        <span class="quiz-go">gram! →</span>
      </a>
    ))}
  </div>

  <p class="quiz-note">Więcej quizów pojawia się razem z nowymi lekcjami. Jest już też <a href={href('mix/')}><strong>⚡ Wielki Mix</strong></a> — wszystkie przypadki naraz, bez podziału na bloki.</p>
</Base>

<style>
  .page-head { padding-top: 30px; }
  .page-h1 { font-size: clamp(2.2rem, 7vw, 3.4rem); font-weight: 800; margin: 0 0 22px; text-transform: uppercase; }

  .quiz-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 14px;
  }
  .quiz-card {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 20px 18px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 2px);
    text-decoration: none;
    color: var(--text);
    position: relative;
    overflow: hidden;
    transition: transform 0.18s ease, border-color 0.18s ease;
    animation: rise 0.45s both;
  }
  .quiz-card::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: var(--zielony);
    opacity: 0.85;
  }
  .quiz-card:hover { transform: translateY(-4px); border-color: var(--zielony); }
  .quiz-emoji { font-size: 1.9rem; line-height: 1; }
  .quiz-title { font-family: var(--font-display); font-weight: 800; font-size: 1.05rem; }
  .quiz-meta { color: var(--text-dim); font-size: 0.85rem; }
  .quiz-go { font-family: var(--font-display); font-weight: 700; font-size: 0.85rem; color: var(--zielony); margin-top: 6px; }

  .quiz-note { color: var(--text-dim); margin-top: 26px; font-size: 0.92rem; }
  .quiz-note strong { color: var(--text); }

  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
