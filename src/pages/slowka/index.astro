---
import Base from '../../layouts/Base.astro';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${b}/${p.replace(/^\//, '')}`;

// Wszystkie talie ze słówkami — jeden plik JSON na lekcję.
const pliki = import.meta.glob<{ lekcja: number; temat: string; slowa: any[] }>(
  '../../data/slowka/*.json',
  { eager: true }
);

const talie = Object.entries(pliki)
  .map(([sciezka, dane]) => ({
    id: sciezka.split('/').pop()!.replace('.json', ''),
    lekcja: dane.lekcja,
    temat: dane.temat,
    ile: dane.slowa.length,
    ids: dane.slowa.map((s) => s.id),
  }))
  .sort((a, c) => a.lekcja - c.lekcja);

const razem = talie.reduce((s, t) => s + t.ile, 0);

// Mapa talia → id słów, żeby skrypt mógł policzyć postęp z localStorage.
const mapaId = Object.fromEntries(talie.map((t) => [t.id, t.ids]));
---
<Base title="Słówka — Polski Klub" active="slowka">
  <header class="page-head">
    <p class="kicker" style="color: var(--blekit)">powtórki rozłożone w czasie</p>
    <h1 class="page-h1">Słówka</h1>
    <p class="page-sub">
      {razem} słów z {talie.length} lekcji. System Leitnera: słowo, które umiesz, wraca coraz rzadziej —
      po 1, 3, 7 i 21 dniach. Słowo, które pomylisz, wraca jutro.
      Postęp zapisuje się w tej przeglądarce, każdy uczy się u siebie.
    </p>
  </header>

  <a class="dzis-card" href={href('slowka/dzis/')}>
    <span class="dzis-left">
      <span class="dzis-label">Dzisiejsza powtórka</span>
      <span class="dzis-desc" id="dzis-desc">wszystkie słowa, które czekają na dziś</span>
    </span>
    <span class="dzis-num" id="dzis-num">—</span>
  </a>

  <section class="stat-row" id="stat-row">
    <div class="stat"><span class="stat-num" id="st-umiane">—</span><span class="stat-lab">umiane</span></div>
    <div class="stat"><span class="stat-num" id="st-wtrakcie">—</span><span class="stat-lab">w trakcie</span></div>
    <div class="stat"><span class="stat-num" id="st-nowe">—</span><span class="stat-lab">nowe</span></div>
    <div class="stat"><span class="stat-num" id="st-razem">{razem}</span><span class="stat-lab">razem</span></div>
  </section>

  <h2 class="section-title">Talie z lekcji</h2>
  <div class="talia-grid">
    {talie.map((t, i) => (
      <a class="talia-card" href={href(`slowka/${t.id}/`)} style={`animation-delay: ${i * 55}ms`}>
        <span class="talia-num">{String(t.lekcja).padStart(2, '0')}</span>
        <span class="talia-body">
          <span class="talia-temat">{t.temat}</span>
          <span class="talia-ile">{t.ile} słów</span>
          <span class="talia-bar"><span class="talia-fill" data-talia={t.id}></span></span>
        </span>
        <span class="talia-pct" data-pct={t.id}>—</span>
      </a>
    ))}
  </div>

  <p class="reset-wrap">
    <button class="reset-btn" id="reset-btn" type="button">Wyzeruj mój postęp</button>
  </p>

  <script type="application/json" id="mapa-id" set:html={JSON.stringify(mapaId)}></script>
</Base>

<script>
  import { wczytajStan, statystyki } from '../../scripts/flashcards.js';

  const mapaId = JSON.parse(document.getElementById('mapa-id').textContent);
  const stan = wczytajStan();
  const teraz = Date.now();

  // Postęp każdej talii z osobna
  let wszystkie = [];
  for (const [talia, ids] of Object.entries(mapaId)) {
    const slowa = ids.map((id) => ({ id }));
    wszystkie = wszystkie.concat(slowa);
    const st = statystyki(slowa, stan, teraz);

    const fill = document.querySelector(`.talia-fill[data-talia="${talia}"]`);
    if (fill) fill.style.width = `${st.procent}%`;
    const pct = document.querySelector(`[data-pct="${talia}"]`);
    if (pct) pct.textContent = `${st.procent}%`;
  }

  const ogolem = statystyki(wszystkie, stan, teraz);
  document.getElementById('st-umiane').textContent = ogolem.umiane;
  document.getElementById('st-wtrakcie').textContent = ogolem.wTrakcie;
  document.getElementById('st-nowe').textContent = ogolem.nowe;

  document.getElementById('dzis-num').textContent = ogolem.doNauki;
  document.getElementById('dzis-desc').textContent =
    ogolem.doNauki === 0
      ? 'wszystko powtórzone — wróć jutro'
      : `${ogolem.zalegle} do powtórki + ${ogolem.nowe} nowych`;

  // Bez window.confirm — modalne okna blokują stronę. Dwa kliknięcia wystarczą.
  const btn = document.getElementById('reset-btn');
  btn.addEventListener('click', () => {
    if (btn.dataset.pewny !== 'tak') {
      btn.dataset.pewny = 'tak';
      btn.textContent = 'Na pewno? Kliknij jeszcze raz';
      btn.classList.add('pewny');
      setTimeout(() => {
        btn.dataset.pewny = '';
        btn.textContent = 'Wyzeruj mój postęp';
        btn.classList.remove('pewny');
      }, 4000);
      return;
    }
    localStorage.removeItem('pk_slowka_v1');
    location.reload();
  });
</script>

<style>
  .page-head { padding-top: 30px; }
  .page-h1 { font-size: clamp(2.2rem, 7vw, 3.4rem); font-weight: 800; margin: 0 0 10px; text-transform: uppercase; }
  .page-sub { color: var(--text-dim); max-width: 62ch; margin: 0 0 26px; line-height: 1.6; }

  .dzis-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 22px 24px;
    margin-bottom: 18px;
    background: linear-gradient(120deg, color-mix(in srgb, var(--blekit) 22%, var(--panel)), var(--panel));
    border: 1px solid color-mix(in srgb, var(--blekit) 45%, var(--line));
    border-radius: calc(var(--radius) + 4px);
    text-decoration: none;
    color: var(--text);
    transition: transform 0.18s ease, border-color 0.18s ease;
  }
  .dzis-card:hover { transform: translateY(-3px); border-color: var(--blekit); }
  .dzis-left { display: flex; flex-direction: column; gap: 4px; }
  .dzis-label { font-family: var(--font-display); font-weight: 800; font-size: 1.35rem; }
  .dzis-desc { color: var(--text-dim); font-size: 0.92rem; }
  .dzis-num {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 800;
    color: var(--blekit);
    font-variant-numeric: tabular-nums;
  }

  .stat-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 34px; }
  .stat {
    display: flex; flex-direction: column; align-items: center; gap: 2px;
    padding: 14px 8px; background: var(--panel); border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .stat-num { font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; font-variant-numeric: tabular-nums; }
  .stat-lab { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-dim); }

  .section-title { font-size: 1.3rem; text-transform: uppercase; margin: 0 0 14px; }

  .talia-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
  .talia-card {
    display: flex; align-items: center; gap: 14px;
    padding: 16px 18px;
    background: var(--panel); border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none; color: var(--text);
    transition: transform 0.18s ease, border-color 0.18s ease;
    animation: rise 0.45s both;
  }
  .talia-card:hover { transform: translateY(-3px); border-color: var(--blekit); }
  .talia-num {
    font-family: var(--font-display); font-size: 1.6rem; font-weight: 800;
    color: var(--text-dim); font-variant-numeric: tabular-nums;
  }
  .talia-body { display: flex; flex-direction: column; gap: 5px; flex: 1; min-width: 0; }
  .talia-temat { font-weight: 700; }
  .talia-ile { font-size: 0.8rem; color: var(--text-dim); }
  .talia-bar { height: 5px; background: var(--panel-2); border-radius: 99px; overflow: hidden; }
  .talia-fill { display: block; height: 100%; width: 0; background: var(--blekit); transition: width 0.5s ease; }
  .talia-pct {
    font-size: 0.85rem; color: var(--text-dim);
    font-variant-numeric: tabular-nums; min-width: 3ch; text-align: right;
  }

  .reset-wrap { margin: 40px 0 10px; text-align: center; }
  .reset-btn {
    background: none; border: 1px solid var(--line); color: var(--text-dim);
    padding: 8px 16px; border-radius: 99px; cursor: pointer;
    font-family: var(--font-body); font-size: 0.82rem;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .reset-btn:hover { color: var(--mak); border-color: var(--mak); }
  .reset-btn.pewny { color: var(--mak); border-color: var(--mak); }

  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }

  @media (max-width: 560px) {
    .stat-row { grid-template-columns: repeat(2, 1fr); }
    .dzis-num { font-size: 2rem; }
  }
</style>
