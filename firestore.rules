rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tylko trojka klubu — publiczny config pozwala kazdemu zalozyc konto,
    // ale reguly nie wpuszczaja obcych do danych.
    function jestSwoj() {
      return request.auth != null
        && request.auth.token.email in
           ['oleg@polskiklub.local', 'lena@polskiklub.local', 'zenia@polskiklub.local'];
    }
    match /users/{uid} {
      allow read: if jestSwoj();
      allow create, update: if jestSwoj() && request.auth.uid == uid;
      allow delete: if false;
      match /attempts/{attemptId} {
        allow read: if jestSwoj();
        allow create: if jestSwoj() && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }
  }
}
